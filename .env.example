# Future Firebase Web config. Leave unset until Firebase is created.
# Copy values from Firebase console > Project settings > Your apps > Web app.
# Register them in Vercel > Project > Settings > Environment Variables, not in git.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
